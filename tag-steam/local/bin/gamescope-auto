#!/bin/sh

if [ "$#" -eq 0 ]; then
	echo "Usage: ${0##*/} command [args...]" >&2
	exit 2
fi

# Steam already runs inside Gamescope; preserve its environment and compositor.
if [ "${XDG_SESSION_DESKTOP:-}" = gamescope ] &&
	[ -n "${GAMESCOPE_WAYLAND_DISPLAY:-}" ]; then
	exec "$@"
fi

_notify() {
	notify-send -i sc-controller "gamescope-auto" "$@"
}

# Get the current mode, name and HDR state of the focused monitor.
read -r width height refresh output hdr <<EOF
	$(swaymsg -t get_outputs |
		jq -r '.[] | select(.focused) |
			"\(.current_mode.width) \(.current_mode.height) \(.current_mode.refresh) \(.name) \(.hdr)"')
EOF
refresh=$(( refresh / 1000 ))

# Patched Gamescope (PR #2358) until HDR on Sway works upstream.
gamescope_bin="$HOME/dev/explore/gamescope/build/src/gamescope"
[ -x "$gamescope_bin" ] || gamescope_bin="$(command -v gamescope)"

# To setup the --rt flag you need:
# sudo setcap 'cap_sys_nice=eip' "$gamescope_bin"
capabilities="$(getcap "$gamescope_bin")"
case "$capabilities" in
	*cap_sys_nice=eip*) ;;
	*)
		_notify "Please set capabilities for $gamescope_bin"
		exit 1
		;;
esac

# Gamescope only exposes HDR when the parent output is in HDR mode. Enable it
# for the game only (requires WLR_RENDERER=vulkan) and restore SDR on exit.
restore_sdr=
if [ "$hdr" != true ]; then
	restore_sdr=1
	swaymsg -q output "$output" hdr on || _notify "Could not enable HDR on $output"
	trap 'swaymsg -q output "$output" hdr off' EXIT
	trap 'exit 130' HUP INT TERM
fi

export ENABLE_GAMESCOPE_WSI=1
export GAMESCOPE_DISABLE_EXPLICIT_SYNC=1
export MESA_VK_WSI_PRESENT_MODE=immediate

_notify "Starting gamescope with ${width}x${height}@${refresh}Hz"

echo "w:$width h:$height r:$refresh cmd:$*" \
	>> /tmp/gamescope-auto.log

# Unset LD_PRELOAD for gamescope itself (Steam runtime libs break gamescope
# rendering), then restore it for the game so Steam Input/overlay still work.
# Gamescope exports DXVK_HDR=0 before the nested window gets the HDR output's
# description, so opt the game in explicitly.
# shellcheck disable=2153
ld_preload="$LD_PRELOAD"

set -- env -u LD_PRELOAD \
	gamemoderun "$gamescope_bin" \
	--hdr-enabled \
	--mangoapp \
	--rt \
	--xwayland-count 2 \
	--framerate-limit "$refresh" \
	--nested-refresh "$refresh" \
	--output-width "$width" \
	--output-height "$height" \
	--nested-width "$width" \
	--nested-height "$height" \
	--fullscreen -- env LD_PRELOAD="$ld_preload" DXVK_HDR=1 "$@"

[ -n "$restore_sdr" ] || exec "$@"

# Run Gamescope in the background so signals can be forwarded to it; a
# foreground child would delay the traps until it exits on its own.
"$@" &
pid=$!
trap 'kill "$pid" 2>/dev/null' HUP INT TERM
wait "$pid"
status=$?
# A trapped signal interrupts wait; keep waiting until Gamescope has exited.
while kill -0 "$pid" 2>/dev/null; do
	wait "$pid"
	status=$?
done
exit "$status"
