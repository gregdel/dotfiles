#!/bin/sh

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamescope

gamescope_config="$HOME/.config/gamescope"
mkdir -p "$gamescope_config"
export GAMESCOPE_MODE_SAVE_FILE="$gamescope_config/modes.cfg"
export GAMESCOPE_LOGS="$HOME/gamescope.log"

if pgrep --quiet steam; then
	steam -shutdown >/dev/null 2>&1 || true
	sleep 1
fi

unset ENABLE_GAMESCOPE_WSI DXVK_HDR
case "${1:-}" in
	monitor)
		export ENABLE_GAMESCOPE_WSI=1
		export DXVK_HDR=1
		# Native HDR games use HDR; SDR content stays color-managed SDR.
		set -- -O DP-2 --adaptive-sync --hdr-enabled
		;;
	tv)
		set -- -O DP-1
		;;
	*)
		echo "Usage: ${0##*/} {monitor|tv}" >&2
		exit 2
		;;
esac

gamescope \
	"$@" \
	--mangoapp \
	--steam \
	--fullscreen \
	--xwayland-count 2 \
	-- steam -gamepadui -steamos3 -steamdeck 2>&1 | tee "$GAMESCOPE_LOGS"
