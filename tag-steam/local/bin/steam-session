#!/bin/sh

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=gamescope
export XDG_SESSION_DESKTOP=gamescope
export SDL_VIDEODRIVER=wayland

gamescope_config="$HOME/.config/gamescope"
mkdir -p "$gamescope_config"
export GAMESCOPE_MODE_SAVE_FILE="$gamescope_config/modes.cfg"

if pgrep --quiet steam; then
	steam -shutdown >/dev/null 2>&1 || true
	sleep 1
fi

case "$1" in
	tv) set -- -O DP-1 ;;
	*)  set --         ;;
esac

gamescope \
	"$@" \
	--mangoapp \
	--steam \
	--fullscreen \
	--xwayland-count 2 \
	-- steam -gamepadui -steamos3 -steamdeck
