# vim: ft=sh :
# shellcheck disable=2034

EXCLUDES="README.md install.sh"
SYMLINK_DIRS="vim nvim oh-my-zsh mutt awesome urxvt tmux gpkg.d"
TAGS="gpkg"

read -r hostname < /etc/hostname
[ -z "$hostname" ] && return 0
case "$hostname" in
  brian)
    TAGS="$TAGS fonts foot steam music ai"
    ;;
  laptop14*)
    TAGS="$TAGS fonts work gofi ai"
    ;;
  lois)
    TAGS="$TAGS fonts foot music gofi"
    ;;
esac
