#!/bin/sh
# shellcheck disable=3043
# Output CPU and GPU telemetry for the quickshell bar as a single JSON line:
#   {"cpu":<°C>,"edge":<°C>,"junc":<°C>,"mem":<°C>,"fan":<%>,"vram":<MB>,"vram_total":<MB>}
# Unavailable sensors are null.

# read a hwmon temperature in °C by driver name and label; empty if unavailable
_read_temp() {
    local driver="$1" label="$2" dir file lbl val
    for dir in /sys/class/hwmon/hwmon*/; do
        [ "$(cat "${dir}name" 2>/dev/null)" = "$driver" ] || continue
        for file in "${dir}"temp*_label; do
            [ -f "$file" ] || continue
            lbl=$(cat "$file" 2>/dev/null)
            [ "$lbl" = "$label" ] || continue
            val=$(cat "${file%_label}_input" 2>/dev/null)
            case "$val" in
                ''|*[!0-9]*) continue ;;
            esac
            printf '%s' "$(( val / 1000 ))"
            return 0
        done
    done
}

# Find the amdgpu DRM device with the most VRAM. DRM card numbers are not
# stable, while the device selected here is used consistently for all GPU data.
_find_gpu_device() {
    local card device driver total best_device="" best_total=-1
    for card in /sys/class/drm/card[0-9]*; do
        [ -e "$card/device" ] || continue
        device=$(readlink -f "$card/device") || continue
        driver=$(basename "$(readlink -f "$device/driver")")
        [ "$driver" = "amdgpu" ] || continue

        total=$(cat "$device/mem_info_vram_total" 2>/dev/null)
        case "$total" in
            ''|*[!0-9]*) continue ;;
        esac
        if [ "$total" -gt "$best_total" ]; then
            best_device=$device
            best_total=$total
        fi
    done
    printf '%s' "$best_device"
}

_read_device_temp() {
    local device="$1" label="$2" file lbl val
    [ -n "$device" ] || return 0
    for file in "$device"/hwmon/hwmon*/temp*_label; do
        [ -f "$file" ] || continue
        lbl=$(cat "$file" 2>/dev/null)
        [ "$lbl" = "$label" ] || continue
        val=$(cat "${file%_label}_input" 2>/dev/null)
        case "$val" in
            ''|*[!0-9]*) continue ;;
        esac
        printf '%s' "$(( val / 1000 ))"
        return 0
    done
}

gpu_device=$(_find_gpu_device)
cpu=$(_read_temp k10temp Tctl)
edge=$(_read_device_temp "$gpu_device" edge)
junc=$(_read_device_temp "$gpu_device" junction)
mem=$(_read_device_temp "$gpu_device" mem)

# fan percentage
fan_input=""
fan_max=""
if [ -n "$gpu_device" ]; then
    for fan_file in "$gpu_device"/hwmon/hwmon*/fan1_input; do
        [ -f "$fan_file" ] || continue
        fan_input=$(cat "$fan_file" 2>/dev/null)
        fan_max=$(cat "${fan_file%_input}_max" 2>/dev/null)
        break
    done
fi
fan=""
case "$fan_input" in
    ''|*[!0-9]*) ;;
    *)
        if [ -n "$fan_max" ] && [ "$fan_max" -gt 0 ] 2>/dev/null; then
            fan=$(( fan_input * 100 / fan_max ))
        fi
    ;;
esac

# VRAM in MB
vram_used_bytes=""
vram_total_bytes=""
if [ -n "$gpu_device" ]; then
    vram_used_bytes=$(cat "$gpu_device/mem_info_vram_used" 2>/dev/null)
    vram_total_bytes=$(cat "$gpu_device/mem_info_vram_total" 2>/dev/null)
fi
vram=""
vram_total=""
case "$vram_used_bytes" in
    ''|*[!0-9]*) ;;
    *)
        if [ -n "$vram_total_bytes" ] && [ "$vram_total_bytes" -gt 0 ] 2>/dev/null; then
            vram=$(( vram_used_bytes / 1048576 ))
            vram_total=$(( vram_total_bytes / 1048576 ))
        fi
    ;;
esac

# collect as strings, let jq turn each into a JSON number or null
jq -cn \
    --arg cpu "$cpu" \
    --arg edge "$edge" \
    --arg junc "$junc" \
    --arg mem "$mem" \
    --arg fan "$fan" \
    --arg vram "$vram" \
    --arg vram_total "$vram_total" \
    'def n: if . == "" then null else tonumber end;
     {cpu: ($cpu | n), edge: ($edge | n), junc: ($junc | n), mem: ($mem | n),
      fan: ($fan | n), vram: ($vram | n), vram_total: ($vram_total | n)}'
