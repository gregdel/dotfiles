#!/bin/sh
# Benchmark the llama.cpp model currently selected in Pi.
#
# Fixed workload:
#   - total context: 8,192, 65,536, and 100,000 tokens
#   - generation: 512 tokens, twice at each context depth
#   - first run: cold prompt; second run: prompt cache enabled
#
# The script is read-only with respect to the router. It never downloads,
# loads, unloads, reloads, or edits a model.

# local is supported by the project shell policy.
# shellcheck disable=SC3043

set -u
umask 077

DECODE_TOKENS=512
CONTEXTS="8192 65536 100000"
MIN_CONTEXT=65536
PREFERRED_CONTEXT=100000
MIN_FREE_BYTES=$((200 * 1024 * 1024))
HTTP_TIMEOUT=1800
WORKLOAD_VERSION=1

TMPDIR_BENCH=
AUTH_HEADER=
VRAM_LOG=
VRAM_MONITOR_PID=
VRAM_TOTAL=null
VRAM_BASELINE=null
VRAM_SOURCE=null
RESULTS_FILE=

usage() {
	cat <<EOF
Usage: $(basename "$0") [--help]

Benchmark the model currently selected by Pi. PI_PROVIDER must be llama.cpp,
and the selected model must already be loaded or sleeping.

Fixed workload:
  contexts     8192, 65536, 100000 total tokens
  generation   512 tokens, 2 runs per context
  VRAM target  at least 200 MiB free when local AMD counters are available

Output is one compact JSON document. The script never changes router state.
EOF
}

case "${1:-}" in
	"") ;;
	--help | -h)
		usage
		exit 0
		;;
	*)
		usage >&2
		exit 64
		;;
esac
[ "$#" -le 1 ] || {
	usage >&2
	exit 64
}

for command in curl jq awk mktemp; do
	command -v "$command" >/dev/null 2>&1 || {
		printf 'missing dependency: %s\n' "$command" >&2
		exit 69
	}
done

cleanup() {
	if [ -n "$VRAM_MONITOR_PID" ]; then
		kill "$VRAM_MONITOR_PID" 2>/dev/null || true
		wait "$VRAM_MONITOR_PID" 2>/dev/null || true
	fi
	[ -n "$TMPDIR_BENCH" ] && rm -rf "$TMPDIR_BENCH"
}
trap cleanup 0 HUP INT TERM

TMPDIR_BENCH=$(mktemp -d "${TMPDIR:-/tmp}/llama-cpp-benchmark.XXXXXX") || exit 70
AUTH_HEADER=$TMPDIR_BENCH/auth-header
VRAM_LOG=$TMPDIR_BENCH/vram.log
RESULTS_FILE=$TMPDIR_BENCH/results.jsonl
: >"$VRAM_LOG"
: >"$RESULTS_FILE"

fail_json() {
	local code="$1" message="$2"
	jq -nc \
		--arg code "$code" \
		--arg message "$message" \
		--arg provider "${PI_PROVIDER:-}" \
		--arg model "${PI_MODEL:-}" \
		'{schema_version:1,status:"failed",provider:$provider,model:$model,error:{code:$code,message:$message}}'
	exit 1
}

[ "${PI_PROVIDER:-}" = "llama.cpp" ] ||
	fail_json wrong_provider "select a loaded llama.cpp model in Pi before running the benchmark"
MODEL=${PI_MODEL:-}
[ -n "$MODEL" ] || fail_json missing_model "PI_MODEL is not set"

PI_DIR=${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}
AUTH_JSON=$PI_DIR/auth.json
STORED_URL=
STORED_KEY=
if [ -r "$AUTH_JSON" ]; then
	STORED_URL=$(jq -r '.["llama.cpp"].env.LLAMA_BASE_URL // empty' "$AUTH_JSON" 2>/dev/null || true)
	STORED_KEY=$(jq -r '.["llama.cpp"].key // empty' "$AUTH_JSON" 2>/dev/null || true)
fi
ROUTER_URL=${STORED_URL:-${LLAMA_BASE_URL:-}}
API_KEY=${STORED_KEY:-${LLAMA_API_KEY:-}}
[ -n "$ROUTER_URL" ] || fail_json missing_router "configure llama.cpp with /login llama.cpp"
ROUTER_URL=${ROUTER_URL%/}
case "$ROUTER_URL" in
	*/v1) ROUTER_URL=${ROUTER_URL%/v1} ;;
esac

if [ -n "$API_KEY" ]; then
	printf 'Authorization: Bearer %s\n' "$API_KEY" >"$AUTH_HEADER"
fi

http() {
	if [ -s "$AUTH_HEADER" ]; then
		curl -sS --fail-with-body --connect-timeout 10 --max-time "$HTTP_TIMEOUT" \
			--header "@$AUTH_HEADER" "$@"
	else
		curl -sS --fail-with-body --connect-timeout 10 --max-time "$HTTP_TIMEOUT" "$@"
	fi
}

HEALTH=$(http "$ROUTER_URL/health" 2>/dev/null) ||
	fail_json router_unreachable "the configured llama.cpp router is unreachable"
printf '%s\n' "$HEALTH" | jq -e '.status == "ok"' >/dev/null 2>&1 ||
	fail_json router_unhealthy "the configured llama.cpp router is not healthy"

MODELS=$(http "$ROUTER_URL/models" 2>/dev/null) ||
	fail_json models_unavailable "could not read the llama.cpp model catalog"
STATUS_JSON=$(printf '%s\n' "$MODELS" | jq -c --arg model "$MODEL" '.data[]? | select(.id == $model)' | head -n 1)
[ -n "$STATUS_JSON" ] || fail_json model_not_found "PI_MODEL is absent from the configured router"
MODEL_STATE=$(printf '%s\n' "$STATUS_JSON" | jq -r '.status.value // empty')
case "$MODEL_STATE" in
	loaded | sleeping) ;;
	*) fail_json model_not_loaded "load the selected model with /llama before benchmarking" ;;
esac

PROPS=$(http -G --data-urlencode "model=$MODEL" "$ROUTER_URL/props" 2>/dev/null) ||
	fail_json props_unavailable "could not read the selected model properties"
N_CTX=$(printf '%s\n' "$PROPS" | jq -er '.default_generation_settings.n_ctx | select(type == "number" and . > 0)' 2>/dev/null) ||
	fail_json props_invalid "the selected model did not report a context size"
BUILD_INFO=$(printf '%s\n' "$PROPS" | jq -r '.build_info // "unknown"')
EFFECTIVE_ARGS=$(printf '%s\n' "$STATUS_JSON" | jq -c '.status.args // []')

router_host() {
	printf '%s\n' "$ROUTER_URL" | jq -Rr '
		capture("^[A-Za-z][A-Za-z0-9+.-]*://(?<authority>[^/]+)").authority |
		sub("^.*@"; "") |
		if startswith("[") then capture("^\\[(?<host>[^]]+)\\]").host
		else split(":")[0] end' 2>/dev/null
}

router_is_local() {
	local host="$1" resolved local_ips ip
	case "$host" in
		localhost | ::1 | 127.*) return 0 ;;
	esac
	command -v ip >/dev/null 2>&1 || return 1
	command -v getent >/dev/null 2>&1 || return 1
	resolved=$(getent ahostsv4 "$host" 2>/dev/null | awk '{print $1}' | sort -u)
	[ -n "$resolved" ] || return 1
	local_ips=$(ip -o -4 addr show 2>/dev/null | awk '{split($4, part, "/"); print part[1]}')
	for ip in $resolved; do
		printf '%s\n' "$local_ips" | grep -Fx "$ip" >/dev/null 2>&1 && return 0
	done
	return 1
}

find_vram_counters() {
	local root candidate total used count=0 found_total="" found_used=""
	for root in /run/host-sys /sys; do
		[ -d "$root/class/drm" ] || continue
		for candidate in "$root"/class/drm/card*/device/mem_info_vram_total; do
			[ -r "$candidate" ] || continue
			total=$(cat "$candidate" 2>/dev/null || true)
			used=${candidate%_total}_used
			case "$total" in "" | *[!0-9]*) continue ;; esac
			[ "$total" -gt 0 ] 2>/dev/null || continue
			[ -r "$used" ] || continue
			count=$((count + 1))
			found_total=$candidate
			found_used=$used
		done
		[ "$count" -gt 0 ] && break
	done
	[ "$count" -eq 1 ] || return 1
	VRAM_TOTAL_PATH=$found_total
	VRAM_USED_PATH=$found_used
	return 0
}

record_vram() {
	local used
	used=$(cat "$VRAM_USED_PATH" 2>/dev/null || true)
	case "$used" in "" | *[!0-9]*) return ;; esac
	printf '%s\n' "$used" >>"$VRAM_LOG"
}

start_vram_monitor() {
	while :; do
		record_vram
		sleep 0.1
	done
}

HOST=$(router_host || true)
if [ -n "$HOST" ] && router_is_local "$HOST" && find_vram_counters; then
	VRAM_TOTAL=$(cat "$VRAM_TOTAL_PATH")
	VRAM_BASELINE=$(cat "$VRAM_USED_PATH")
	VRAM_SOURCE=$(jq -Rn --arg path "$VRAM_USED_PATH" '$path')
	record_vram
	start_vram_monitor &
	VRAM_MONITOR_PID=$!
fi

vram_for_range() {
	local first_line="$1" stats peak min_free
	if [ "$VRAM_TOTAL" = null ]; then
		printf '{"peak_used_bytes":null,"min_free_bytes":null,"headroom_ok":null}'
		return
	fi
	stats=$(awk -v first="$first_line" 'NR >= first { if (peak == "" || $1 > peak) peak = $1 } END { if (peak == "") print "null"; else print peak }' "$VRAM_LOG")
	peak=$stats
	if [ "$peak" = null ]; then
		printf '{"peak_used_bytes":null,"min_free_bytes":null,"headroom_ok":null}'
		return
	fi
	min_free=$((VRAM_TOTAL - peak))
	jq -nc --argjson peak "$peak" --argjson free "$min_free" --argjson target "$MIN_FREE_BYTES" \
		'{peak_used_bytes:$peak,min_free_bytes:$free,headroom_ok:($free >= $target)}'
}

make_content() {
	local records="$1" output="$2"
	awk -v records="$records" 'BEGIN {
		for (i = 0; i < records; i++) {
			module = (i * 17 + 11) % 997
			line = (i * 7919 + 23) % 1000003
			printf "module shard_%04d { fn process_%06d(packet: &mut Packet, state: &State) -> Result<usize, Error> { ", module, i
			printf "let slot = (%d + packet.len()) %% state.queues.len(); ", line
			printf "if state.queues[slot].is_full() { return Err(Error::Backpressure(%d)); } ", module
			printf "state.queues[slot].push(packet)?; Ok(slot) } } "
			printf "diagnostic: worker=%d generation=%d cache_line=%d latency_us=%d.\n", i % 64, i / 64, (i * 13) % 4096, (i * 37) % 20000
		}
		print "Review the preceding systems code and diagnostics. Continue with a detailed implementation explaining ownership, bounded queues, error handling, memory locality, and concurrency. Include concrete code and tests."
	}' >"$output"
}

input_tokens() {
	local content="$1" request="$TMPDIR_BENCH/input-tokens.json" response="$TMPDIR_BENCH/input-tokens-response.json"
	jq -Rs --arg model "$MODEL" --argjson max "$DECODE_TOKENS" \
		'{model:$model,messages:[{role:"user",content:.}],max_tokens:$max}' \
		<"$content" >"$request" || return 1
	http -H 'Content-Type: application/json' --data-binary "@$request" \
		"$ROUTER_URL/v1/chat/completions/input_tokens" >"$response" 2>/dev/null || return 1
	jq -er '.input_tokens | select(type == "number" and . > 0)' "$response"
}

build_workload() {
	local total="$1" output="$2" target sample sample_tokens records actual next iteration=0 tolerance=1024
	target=$((total - DECODE_TOKENS))
	sample=$TMPDIR_BENCH/sample.txt
	make_content 128 "$sample"
	sample_tokens=$(input_tokens "$sample") || return 1
	records=$((target * 128 / sample_tokens))
	[ "$records" -gt 0 ] || records=1
	while [ "$iteration" -lt 6 ]; do
		make_content "$records" "$output"
		actual=$(input_tokens "$output") || return 1
		if [ "$actual" -le "$target" ] && [ "$actual" -ge $((target - tolerance)) ]; then
			printf '%s\n' "$actual"
			return 0
		fi
		next=$((records * target / actual))
		if [ "$next" -eq "$records" ]; then
			if [ "$actual" -gt "$target" ]; then next=$((records - 1)); else next=$((records + 1)); fi
		fi
		[ "$next" -gt 0 ] || next=1
		records=$next
		iteration=$((iteration + 1))
	done
	[ "$actual" -le "$target" ] && [ "$actual" -ge $((target - tolerance * 2)) ] || return 1
	printf '%s\n' "$actual"
}

run_trial() {
	local context="$1" run="$2" cache="$3" content="$4" actual="$5"
	local request="$TMPDIR_BENCH/request-$context-$run.json"
	local response="$TMPDIR_BENCH/response-$context-$run.json"
	local summary="$TMPDIR_BENCH/summary-$context-$run.json"
	jq -Rs \
		--arg model "$MODEL" \
		--argjson max "$DECODE_TOKENS" \
		--argjson cache "$cache" \
		'{model:$model,messages:[{role:"user",content:.}],stream:false,max_tokens:$max,seed:1,ignore_eos:true,cache_prompt:$cache,response_fields:["timings"]}' \
		<"$content" >"$request" || return 1
	if ! http -H 'Content-Type: application/json' --data-binary "@$request" \
		"$ROUTER_URL/v1/chat/completions" >"$response" 2>/dev/null; then
		jq -nc --argjson run "$run" --argjson cache "$cache" \
			'{run:$run,cache_prompt:$cache,valid:false,error:"request_failed"}' >"$summary"
		printf '%s\n' "$summary"
		return 1
	fi
	if ! jq -e . "$response" >/dev/null 2>&1; then
		jq -nc --argjson run "$run" --argjson cache "$cache" \
			'{run:$run,cache_prompt:$cache,valid:false,error:"invalid_json"}' >"$summary"
		printf '%s\n' "$summary"
		return 1
	fi
	jq -c \
		--argjson run "$run" \
		--argjson cache "$cache" \
		--argjson expected "$DECODE_TOKENS" \
		--argjson input "$actual" '
		(.timings.predicted_n // .usage.completion_tokens // null) as $generated |
		{
			run:$run,
			cache_prompt:$cache,
			valid:(($generated != null) and ($generated >= $expected) and ((.timings.predicted_per_second // 0) > 0)),
			input_tokens:(.usage.prompt_tokens // $input),
			generated_tokens:$generated,
			finish_reason:(.choices[0].finish_reason // null),
			prompt_seconds:(if .timings.prompt_ms == null then null else .timings.prompt_ms / 1000 end),
			prompt_tokens_per_second:(.timings.prompt_per_second // null),
			generation_seconds:(if .timings.predicted_ms == null then null else .timings.predicted_ms / 1000 end),
			generation_tokens_per_second:(.timings.predicted_per_second // null),
			cache_tokens:(.timings.cache_n // null),
			evaluated_prompt_tokens:(.timings.prompt_n // null)
		}' "$response" >"$summary" || return 1
	printf '%s\n' "$summary"
	jq -e '.valid == true' "$summary" >/dev/null 2>&1
}

for total in $CONTEXTS; do
	if [ "$total" -gt "$N_CTX" ]; then
		jq -nc --argjson context "$total" --argjson nctx "$N_CTX" \
			'{context_tokens:$context,status:"unsupported",reason:"server_context_too_small",server_context_tokens:$nctx,input_tokens:null,prefill:null,generation:null,memory:{peak_used_bytes:null,min_free_bytes:null,headroom_ok:null},usable:false}' \
			>>"$RESULTS_FILE"
		continue
	fi

	content=$TMPDIR_BENCH/content-$total.txt
	actual=$(build_workload "$total" "$content") || {
		jq -nc --argjson context "$total" \
			'{context_tokens:$context,status:"failed",reason:"workload_build_failed",input_tokens:null,prefill:null,generation:null,memory:{peak_used_bytes:null,min_free_bytes:null,headroom_ok:null},usable:false}' \
			>>"$RESULTS_FILE"
		continue
	}

	before_lines=$(($(wc -l <"$VRAM_LOG") + 1))
	run1_file=$(run_trial "$total" 1 false "$content" "$actual" || true)
	run2_file=$(run_trial "$total" 2 true "$content" "$actual" || true)
	record_vram 2>/dev/null || true
	memory=$(vram_for_range "$before_lines")

	if [ -n "$run1_file" ] && [ -s "$run1_file" ]; then run1=$(cat "$run1_file"); else run1='{"run":1,"cache_prompt":false,"valid":false,"error":"missing_result"}'; fi
	if [ -n "$run2_file" ] && [ -s "$run2_file" ]; then run2=$(cat "$run2_file"); else run2='{"run":2,"cache_prompt":true,"valid":false,"error":"missing_result"}'; fi

	jq -nc \
		--argjson context "$total" \
		--argjson input "$actual" \
		--argjson decode "$DECODE_TOKENS" \
		--argjson nctx "$N_CTX" \
		--argjson one "$run1" \
		--argjson two "$run2" \
		--argjson memory "$memory" '
		[$one,$two] as $runs |
		([$runs[].generation_tokens_per_second] | map(select(. != null)) | sort) as $rates |
		(($one.valid == true) and ($two.valid == true) and (($input + $decode) <= $nctx)) as $capacity_ok |
		($capacity_ok and ($memory.headroom_ok != false)) as $usable |
		{
			context_tokens:$context,
			status:(if $usable then "passed" else "failed" end),
			reason:(if $capacity_ok|not then "generation_failed" elif $memory.headroom_ok == false then "insufficient_vram_headroom" else null end),
			input_tokens:$input,
			prefill:{seconds:$one.prompt_seconds,tokens_per_second:$one.prompt_tokens_per_second},
			generation:{tokens:$decode,runs:$runs,median_tokens_per_second:(if ($rates|length) == 2 then (($rates[0]+$rates[1])/2) else null end)},
			memory:$memory,
			usable:$usable
		}' >>"$RESULTS_FILE"
done

if [ -n "$VRAM_MONITOR_PID" ]; then
	kill "$VRAM_MONITOR_PID" 2>/dev/null || true
	wait "$VRAM_MONITOR_PID" 2>/dev/null || true
	VRAM_MONITOR_PID=
fi
record_vram 2>/dev/null || true

RESULTS=$(jq -s '.' "$RESULTS_FILE")
MINIMUM_OK=$(printf '%s\n' "$RESULTS" | jq -r --argjson context "$MIN_CONTEXT" 'any(.[]; .context_tokens == $context and .usable == true)')
PREFERRED_OK=$(printf '%s\n' "$RESULTS" | jq -r --argjson context "$PREFERRED_CONTEXT" 'any(.[]; .context_tokens == $context and .usable == true)')
if [ "$MINIMUM_OK" != true ]; then
	VERDICT=failed
elif [ "$PREFERRED_OK" = true ]; then
	VERDICT=preferred
else
	VERDICT=minimum
fi

if [ "$VRAM_TOTAL" = null ]; then
	MEMORY=$(jq -nc --argjson target "$MIN_FREE_BYTES" \
		'{available:false,source:null,total_bytes:null,baseline_used_bytes:null,peak_used_bytes:null,min_free_bytes:null,target_free_bytes:$target,headroom_ok:null}')
else
	PEAK=$(awk '{if (peak == "" || $1 > peak) peak=$1} END {if (peak == "") print "null"; else print peak}' "$VRAM_LOG")
	if [ "$PEAK" = null ]; then
		MIN_FREE=null
		HEADROOM=null
	else
		MIN_FREE=$((VRAM_TOTAL - PEAK))
		if [ "$MIN_FREE" -ge "$MIN_FREE_BYTES" ]; then HEADROOM=true; else HEADROOM=false; fi
	fi
	MEMORY=$(jq -nc \
		--argjson source "$VRAM_SOURCE" \
		--argjson total "$VRAM_TOTAL" \
		--argjson baseline "$VRAM_BASELINE" \
		--argjson peak "$PEAK" \
		--argjson free "$MIN_FREE" \
		--argjson target "$MIN_FREE_BYTES" \
		--argjson ok "$HEADROOM" \
		'{available:true,source:$source,total_bytes:$total,baseline_used_bytes:$baseline,peak_used_bytes:$peak,min_free_bytes:$free,target_free_bytes:$target,headroom_ok:$ok}')
fi

jq -nc \
	--arg status "$VERDICT" \
	--arg provider "$PI_PROVIDER" \
	--arg model "$MODEL" \
	--arg router "$ROUTER_URL" \
	--arg build "$BUILD_INFO" \
	--argjson args "$EFFECTIVE_ARGS" \
	--argjson nctx "$N_CTX" \
	--argjson workload "$WORKLOAD_VERSION" \
	--argjson decode "$DECODE_TOKENS" \
	--argjson minimum "$MIN_CONTEXT" \
	--argjson preferred "$PREFERRED_CONTEXT" \
	--argjson memory "$MEMORY" \
	--argjson results "$RESULTS" \
	'{schema_version:1,status:$status,provider:$provider,model:$model,router_url:$router,server:{build_info:$build,context_tokens:$nctx,effective_args:$args},workload:{version:$workload,contexts:[8192,65536,100000],generation_tokens:$decode,runs_per_context:2,minimum_context:$minimum,preferred_context:$preferred},memory:$memory,results:$results}'

[ "$VERDICT" != failed ]
