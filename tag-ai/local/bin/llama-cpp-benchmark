#!/bin/sh
# Benchmark one already-defined llama.cpp router model preset.
#
# The benchmark is HTTP-only. It never edits the router preset. Use
# --exclusive when cached model-load timing and model lifecycle control are
# required.
#
# Two profiles (all parameters overridable with explicit flags):
#   --fast (default)  triage: 5 fixed sizes, cold-only, 2 runs, 256 decode.
#   --full            acceptance: sizes derived from the preset's n_ctx,
#                     warm+cold, 3 runs, 1024 decode, gate at capacity.

# local is supported by the project shell policy.
# shellcheck disable=SC3043

set -u
umask 077

MODEL=${1:-}
if [ -n "$MODEL" ]; then
	shift
fi

ROUTER_URL=http://127.0.0.1:10999
EXCLUSIVE=0
REPETITIONS=3
HTTP_TIMEOUT=1800
LOAD_TIMEOUT=900
POLL_INTERVAL=1
DECODE_TOKENS=1024
SEED=1
MODE=cold
SIZES_LIST=4096,8192,16384,24576,32768
SIZES_SOURCE=fixed
GATE_CONTEXT=32768
GATE_RUNS=2
FULL=0
MODE_SET=0
SIZES_SET=0
DECODE_SET=0
RUNS_SET=0
GATE_CTX_SET=0
GATE_RUNS_SET=0
SKIPPED_SIZES=
CEILING_SIZE=
CEILING_REASON=
CEILING_JSON=null
VRAM_USED_PATH=/sys/class/drm/card1/device/mem_info_vram_used
VRAM_TOTAL_PATH=/sys/class/drm/card1/device/mem_info_vram_total

TMPDIR_BENCH=
RUNS_FILE=
VRAM_FILE=
MONITOR_PID=
ABORTED=0
STABILITY_FAILURE=0
CONTEXT_FAILURE=0
LOAD_MS=null
LOAD_CACHED=null
LOAD_STATE=not_measured

usage() {
	cat <<EOF
Usage: $(basename "$0") MODEL_ID [options]

Benchmark one named model in a running llama.cpp router.

Modes (default: fast triage):
  --fast                  fast triage: 5 sizes, cold-only, 2 runs, 256 decode
  --full                  acceptance: sizes derived from the preset's n_ctx,
                          warm+cold, 3 runs, 1024 decode, gate at capacity

Options:
  --exclusive             unload/reload models and measure cached load time
  --url URL               router URL (default: $ROUTER_URL)
  --runs N                measured runs per workload (fast: 2, full: 3)
  --sizes A,B,C           total-context sizes in tokens (default: 4096,
                          8192, 16384, 24576, 32768; --full derives from n_ctx)
  --mode cold|warm|both   prompt-cache modes measured (default: cold, full: both)
  --decode-tokens N       generation budget per trial (fast: 256, full: 1024)
  --gate-context N        context size the verdict gates on (default: 32768;
                          --full defaults to the preset's n_ctx; "capacity"
                          selects the preset's n_ctx explicitly)
  --gate-runs N           minimum runs at the gate context for a pass
                          (fast: 2, full: 3)
  --http-timeout SECONDS  request timeout (default: $HTTP_TIMEOUT)
  --load-timeout SECONDS  model load timeout (default: $LOAD_TIMEOUT)
  --help                  show this help

The verdict gates on a specific total-context size: that size must appear
in the results with at least the gate-run count of protocol-valid,
in-capacity trials. Sizes that cannot fit the model's context are skipped
and reported. If any size fails capacity/protocol checks, the ascending
sweep stops there and the output carries a capacity_ceiling record.
EOF
}

if [ -z "$MODEL" ] || [ "$MODEL" = --help ] || [ "$MODEL" = -h ]; then
	usage
	[ -n "$MODEL" ] || exit 64
	exit 0
fi

while [ "$#" -gt 0 ]; do
	case "$1" in
	--exclusive)
		EXCLUSIVE=1
		;;
	--url)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--url requires a value' >&2
			exit 64
		}
		ROUTER_URL=$2
		shift
		;;
	--runs)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--runs requires a value' >&2
			exit 64
		}
		REPETITIONS=$2
		RUNS_SET=1
		shift
		;;
	--http-timeout)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--http-timeout requires a value' >&2
			exit 64
		}
		HTTP_TIMEOUT=$2
		shift
		;;
	--load-timeout)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--load-timeout requires a value' >&2
			exit 64
		}
		LOAD_TIMEOUT=$2
		shift
		;;
	--fast)
		FULL=0
		;;
	--full)
		FULL=1
		;;
	--mode)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--mode requires a value' >&2
			exit 64
		}
		MODE=$2
		MODE_SET=1
		shift
		;;
	--sizes)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--sizes requires a value' >&2
			exit 64
		}
		SIZES_LIST=$2
		SIZES_SET=1
		shift
		;;
	--decode-tokens)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--decode-tokens requires a value' >&2
			exit 64
		}
		DECODE_TOKENS=$2
		DECODE_SET=1
		shift
		;;
	--gate-context)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--gate-context requires a value' >&2
			exit 64
		}
		GATE_CONTEXT=$2
		GATE_CTX_SET=1
		shift
		;;
	--gate-runs)
		[ "$#" -ge 2 ] || {
			printf '%s\n' '--gate-runs requires a value' >&2
			exit 64
		}
		GATE_RUNS=$2
		GATE_RUNS_SET=1
		shift
		;;
	--help | -h)
		usage
		exit 0
		;;
	*)
		printf 'unknown option: %s\n' "$1" >&2
		exit 64
		;;
	esac
	shift
done

valid_uint() {
	case "$1" in
	'' | *[!0-9]*) return 1 ;;
	*) [ "$1" -ge 1 ] 2>/dev/null ;;
	esac
}

valid_uint "$REPETITIONS" || {
	printf '%s\n' '--runs must be a positive integer' >&2
	exit 64
}
valid_uint "$HTTP_TIMEOUT" || {
	printf '%s\n' '--http-timeout must be a positive integer' >&2
	exit 64
}
valid_uint "$LOAD_TIMEOUT" || {
	printf '%s\n' '--load-timeout must be a positive integer' >&2
	exit 64
}

if [ "$FULL" -eq 1 ]; then
	[ "$MODE_SET" -eq 0 ] && MODE=both
	[ "$SIZES_SET" -eq 0 ] && SIZES_SOURCE=derive
	[ "$DECODE_SET" -eq 0 ] && DECODE_TOKENS=1024
	[ "$RUNS_SET" -eq 0 ] && REPETITIONS=3
	[ "$GATE_CTX_SET" -eq 0 ] && GATE_CONTEXT=capacity
	[ "$GATE_RUNS_SET" -eq 0 ] && GATE_RUNS=3
fi

case "$MODE" in
cold | warm | both) ;;
*)
	printf '%s\n' '--mode must be cold, warm, or both' >&2
	exit 64
	;;
esac
valid_uint "$DECODE_TOKENS" || {
	printf '%s\n' '--decode-tokens must be a positive integer' >&2
	exit 64
}
valid_uint "$GATE_RUNS" || {
	printf '%s\n' '--gate-runs must be a positive integer' >&2
	exit 64
}
if [ "$GATE_CONTEXT" != capacity ]; then
	valid_uint "$GATE_CONTEXT" || {
		printf '%s\n' '--gate-context must be a positive integer or "capacity"' >&2
		exit 64
	}
	[ "$GATE_CONTEXT" -ge 4096 ] || {
		printf '%s\n' '--gate-context must be >= 4096' >&2
		exit 64
	}
fi
for size in $(printf '%s\n' "$SIZES_LIST" | tr ',' ' '); do
	case "$size" in
	'' | *[!0-9]*)
		printf '%s\n' '--sizes elements must be positive integers' >&2
		exit 64
		;;
	esac
	[ "$size" -ge 4096 ] 2>/dev/null || {
		printf '%s\n' '--sizes elements must be >= 4096' >&2
		exit 64
	}
done

for command in curl jq awk mktemp node sha256sum; do
	command -v "$command" >/dev/null 2>&1 || {
		printf 'missing dependency: %s\n' "$command" >&2
		exit 69
	}
done

TMPDIR_BENCH=$(mktemp -d "${TMPDIR:-/tmp}/llama-cpp-benchmark.XXXXXX") || exit 70
RUNS_FILE=$TMPDIR_BENCH/runs.jsonl
VRAM_FILE=$TMPDIR_BENCH/vram.log
: >"$RUNS_FILE"
: >"$VRAM_FILE"

cleanup() {
	if [ -n "$MONITOR_PID" ]; then
		kill "$MONITOR_PID" 2>/dev/null || true
		wait "$MONITOR_PID" 2>/dev/null || true
	fi
	[ -n "$TMPDIR_BENCH" ] && rm -rf "$TMPDIR_BENCH"
}
trap cleanup 0 HUP INT TERM

fail_json() {
	code=$1
	message=$2
	jq -nc \
		--arg model "$MODEL" \
		--arg url "$ROUTER_URL" \
		--arg mode "$MODE" \
		--arg code "$code" \
		--arg message "$message" \
		--argjson exclusive "$EXCLUSIVE" \
		'{schema_version:2,status:"failed",model:$model,router_url:$url,exclusive:$exclusive,mode:$mode,failure:{code:$code,message:$message}}'
	exit 1
}

http() {
	curl -fsS --connect-timeout 10 --max-time "$HTTP_TIMEOUT" "$@"
}

health() {
	http "$ROUTER_URL/health" >/dev/null 2>&1
}

models_json() {
	http "$ROUTER_URL/models"
}

model_status() {
	models_json | jq -c --arg model "$MODEL" '.data[]? | select(.id == $model) | .status' | head -n 1
}

model_state() {
	status=$(model_status 2>/dev/null) || return 1
	[ -n "$status" ] || return 1
	printf '%s\n' "$status" | jq -r '.value // empty'
}

post_model_action() {
	action=$1
	request=$TMPDIR_BENCH/model-action.json
	jq -nc --arg model "$MODEL" '{model:$model}' >"$request" || return 1
	http -H 'Content-Type: application/json' --data-binary "@$request" \
		"$ROUTER_URL/models/$action"
}

wait_for_model_state() {
	wanted=$1
	start=$(date +%s)
	SAW_DOWNLOADING=0
	while :; do
		status=$(model_status 2>/dev/null || true)
		if [ -n "$status" ]; then
			state=$(printf '%s\n' "$status" | jq -r '.value // empty')
			[ "$state" = downloading ] && SAW_DOWNLOADING=1
			failed=$(printf '%s\n' "$status" | jq -r '.failed // false')
			[ "$failed" = true ] && return 2
			[ "$state" = "$wanted" ] && return 0
		fi
		now=$(date +%s)
		[ $((now - start)) -lt "$LOAD_TIMEOUT" ] || return 3
		sleep "$POLL_INTERVAL"
	done
}

now_ms() {
	node -e 'process.stdout.write(String(Date.now()))'
}

read_number() {
	file=$1
	if [ -r "$file" ]; then
		value=$(cat "$file" 2>/dev/null || true)
		case "$value" in
		'' | *[!0-9]*) printf 'null\n' ;;
		*) printf '%s\n' "$value" ;;
		esac
	else
		printf 'null\n'
	fi
}

vram_used() {
	read_number "$VRAM_USED_PATH"
}

vram_total() {
	read_number "$VRAM_TOTAL_PATH"
}

record_vram() {
	used=$(vram_used)
	[ "$used" != null ] && printf '%s\n' "$used" >>"$VRAM_FILE"
}

start_vram_monitor() {
	while :; do
		record_vram
		sleep 0.1
	done
}

stop_vram_monitor() {
	if [ -n "$MONITOR_PID" ]; then
		kill "$MONITOR_PID" 2>/dev/null || true
		wait "$MONITOR_PID" 2>/dev/null || true
		MONITOR_PID=
	fi
	record_vram
}

vram_stats_json() {
	total=$1
	if [ "$total" = null ]; then
		printf '{"total_bytes":null,"min_free_bytes":null,"peak_used_bytes":null}'
		return
	fi
	stats=$(awk -v total="$total" '
		BEGIN { min = ""; max = "" }
		{
			free = total - $1
			if (min == "" || free < min) min = free
			if (max == "" || $1 > max) max = $1
		}
		END {
			if (min == "") print "null null"
			else print min, max
		}
	' "$VRAM_FILE")
	min=${stats%% *}
	max=${stats#* }
	printf '{"total_bytes":%s,"min_free_bytes":%s,"peak_used_bytes":%s}' "$total" "$min" "$max"
}

render_prompt() {
	content=$1
	output=$2
	request=$TMPDIR_BENCH/apply-template.json
	response=$TMPDIR_BENCH/apply-template-response.json
	jq -Rs --arg model "$MODEL" '{model:$model,messages:[{role:"user",content:.}]}' \
		<"$content" >"$request" || return 1
	http -H 'Content-Type: application/json' --data-binary "@$request" \
		"$ROUTER_URL/apply-template" >"$response" || return 1
	jq -er '.prompt' "$response" >"$output"
}

token_count() {
	prompt=$1
	request=$TMPDIR_BENCH/tokenize.json
	response=$TMPDIR_BENCH/tokenize-response.json
	jq -Rs --arg model "$MODEL" '{model:$model,content:.,add_special:false}' \
		<"$prompt" >"$request" || return 1
	http -H 'Content-Type: application/json' --data-binary "@$request" \
		"$ROUTER_URL/tokenize" >"$response" || return 1
	jq -er '.tokens | length' "$response"
}

make_content() {
	records=$1
	variant=$2
	output=$3
	awk -v records="$records" -v variant="$variant" 'BEGIN {
		words = "kernel network packet route queue socket memory scheduler process thread cache vector tensor model token context inference protocol ethernet bridge namespace container filesystem interrupt dma pcie rocm compute shader buffer latency throughput lock atomic timer syscall compiler branch register page table descriptor ring batch prompt decode speculative expert mixture dispatch topology numa"
		count = split(words, word, " ")
		for (i = 0; i < records; i++) {
			printf "record %06d variant %d:", i, variant
			for (j = 0; j < 18; j++) {
				k = ((i * 37 + j * 17 + j * j + i * j + variant * 11) % count) + 1
				printf " %s", word[k]
			}
			printf ". value=%d state=%d.\n", (i * 7919 + variant) % 1000003, (i * 13 + variant) % 97
		}
		print "Analyze the preceding technical corpus and continue with a detailed explanation of efficient Linux packet processing, memory locality, and concurrency tradeoffs."
	}' >"$output"
}

build_workload() {
	target=$1
	variant=$2
	bw_content=$3
	bw_rendered=$4
	sample_content=$TMPDIR_BENCH/sample-$variant.txt
	sample_rendered=$TMPDIR_BENCH/sample-rendered-$variant.txt

	# Estimate tokens-per-record from a small deterministic sample so the
	# full-size splice converges in one verification pass. Note: the helpers
	# below mutate globals (content, records, output, prompt); bw_* names are
	# chosen to be immune to that clobbering.
	make_content 64 "$variant" "$sample_content" || return 1
	render_prompt "$sample_content" "$sample_rendered" || return 1
	sample_tokens=$(token_count "$sample_rendered") || return 1
	[ "$sample_tokens" -gt 0 ] || return 1
	bw_records=$((target * 64 / sample_tokens))
	[ "$bw_records" -ge 1 ] || bw_records=1
	i=0
	while [ "$i" -lt 4 ]; do
		make_content "$bw_records" "$variant" "$bw_content" || return 1
		render_prompt "$bw_content" "$bw_rendered" || return 1
		actual=$(token_count "$bw_rendered") || return 1
		lower=$((target * 99 / 100))
		# Accept only at or below the target so prefill+decode never overshoots
		# the model's context, even at the exact-capacity anchor.
		[ "$actual" -ge "$lower" ] && [ "$actual" -le "$target" ] && break
		[ "$actual" -gt 0 ] || return 1
		bw_records=$((bw_records * target / actual))
		[ "$bw_records" -ge 1 ] || bw_records=1
		i=$((i + 1))
	done
	printf '%s\n' "$actual"
}

run_stream() {
	url=$1
	request=$2
	output=$3
	BENCH_URL=$url BENCH_REQUEST=$request BENCH_OUTPUT=$output \
		node <<'NODE'
const fs = require('fs');
const crypto = require('crypto');
const http = require('http');
const https = require('https');

const url = new URL(process.env.BENCH_URL);
const body = fs.readFileSync(process.env.BENCH_REQUEST);
const started = process.hrtime.bigint();
const transport = url.protocol === 'https:' ? https : http;
const result = {
  http_status: null,
  protocol_valid: false,
  parse_errors: 0,
  error: null,
  chunks: 0,
  done: false,
  ttft_seconds: null,
  wall_seconds: null,
  finish_reason: null,
  usage: null,
  timings: null,
  content: '',
  reasoning: ''
};

function seconds() {
  return Number(process.hrtime.bigint() - started) / 1e9;
}
function finish() {
  result.wall_seconds = seconds();
  const generated = result.content + result.reasoning;
  result.output_bytes = Buffer.byteLength(generated);
  result.output_sha256 = crypto.createHash('sha256').update(generated).digest('hex');
  result.content_bytes = Buffer.byteLength(result.content);
  result.reasoning_bytes = Buffer.byteLength(result.reasoning);
  if (!result.protocol_valid && !result.error) result.error = 'invalid_stream';
  fs.writeFileSync(process.env.BENCH_OUTPUT, JSON.stringify(result));
}
function invalid(message) {
  result.parse_errors += 1;
  if (!result.error) result.error = message;
}
function handleData(data) {
  if (data === '[DONE]') {
    result.done = true;
    return;
  }
  let item;
  try { item = JSON.parse(data); }
  catch (_) { invalid('invalid_sse_json'); return; }
  result.chunks += 1;
  if (item.error) invalid('server_error');
  if (item.usage) result.usage = item.usage;
  if (item.timings) result.timings = item.timings;
  const choice = item.choices && item.choices[0];
  if (!choice) return;
  if (choice.finish_reason) result.finish_reason = choice.finish_reason;
  const delta = choice.delta || {};
  const content = typeof delta.content === 'string' ? delta.content : '';
  const reasoning = typeof delta.reasoning_content === 'string' ? delta.reasoning_content : '';
  if (result.ttft_seconds === null && (content.length || reasoning.length || delta.tool_calls)) {
    result.ttft_seconds = seconds();
  }
  result.content += content;
  result.reasoning += reasoning;
}

const request = transport.request({
  method: 'POST',
  hostname: url.hostname,
  port: url.port || (url.protocol === 'https:' ? 443 : 80),
  path: `${url.pathname}${url.search}`,
  headers: {
    'Content-Type': 'application/json',
    'Accept': 'text/event-stream',
    'Content-Length': body.length,
    ...(process.env.BENCH_API_KEY ? {Authorization: `Bearer ${process.env.BENCH_API_KEY}`} : {})
  }
}, response => {
  result.http_status = response.statusCode;
  let buffer = '';
  response.setEncoding('utf8');
  response.on('data', chunk => {
    buffer += chunk;
    let index;
    while ((index = buffer.indexOf('\n')) >= 0) {
      const line = buffer.slice(0, index).replace(/\r$/, '');
      buffer = buffer.slice(index + 1);
      if (line.startsWith('data:')) handleData(line.slice(5).trim());
    }
  });
  response.on('end', () => {
    if (buffer.trim().startsWith('data:')) handleData(buffer.trim().slice(5).trim());
    if (result.http_status !== 200) invalid(`http_${result.http_status}`);
    if (!result.done) invalid('missing_done');
    if (result.chunks === 0) invalid('no_sse_chunks');
    if (result.ttft_seconds === null) invalid('no_first_token');
    if (!result.finish_reason) invalid('missing_finish_reason');
    result.protocol_valid = result.http_status === 200 && result.parse_errors === 0 &&
      result.done && result.chunks > 0 && result.ttft_seconds !== null &&
      result.finish_reason !== null && (result.content.length + result.reasoning.length > 0);
    finish();
  });
});
request.on('error', error => {
  result.error = error.message;
  finish();
});
request.write(body);
request.end();
NODE
}

run_trial() {
	mode=$1
	total=$2
	run=$3
	content=$4
	actual=$5
	request=$TMPDIR_BENCH/request-$mode-$total-$run.json
	response=$TMPDIR_BENCH/response-$mode-$total-$run.json
	before_lines=$(wc -l <"$VRAM_FILE")
	if [ "$mode" = cold ]; then
		CACHE_PROMPT=false
	else
		CACHE_PROMPT=true
	fi
	jq -Rs \
		--arg model "$MODEL" \
		--argjson n "$DECODE_TOKENS" \
		--argjson seed "$SEED" \
		--argjson cache_prompt "$CACHE_PROMPT" \
		'{model:$model,messages:[{role:"user",content:.}],stream:true,stream_options:{include_usage:true},n_predict:$n,seed:$seed,cache_prompt:$cache_prompt,response_fields:["timings","generation_settings"]}' \
		<"$content" >"$request" || return 1

	start_vram_monitor &
	MONITOR_PID=$!
	run_stream "$ROUTER_URL/v1/chat/completions" "$request" "$response"
	stream_rc=$?
	stop_vram_monitor
	[ "$stream_rc" -eq 0 ] || true

	total_vram=$(vram_total)
	if [ "$total_vram" = null ]; then
		min_free=null
		peak_used=null
	else
		stats=$(awk -v total="$total_vram" -v before="$before_lines" 'NR > before {
			free = total - $1
			if (min == "" || free < min) min = free
			if (max == "" || $1 > max) max = $1
		}
		END { if (min == "") print "null null"; else print min, max }' "$VRAM_FILE")
		min_free=${stats%% *}
		peak_used=${stats#* }
	fi

	if [ ! -s "$response" ]; then
		STABILITY_FAILURE=1
		return 1
	fi
	jq -c \
		--arg mode "$mode" \
		--argjson target "$total" \
		--argjson actual "$actual" \
		--argjson run "$run" \
		--argjson nctx "$N_CTX" \
		--argjson min_free "$min_free" \
		--argjson peak_used "$peak_used" \
		'. + {
			mode:$mode,
			target_total_context_tokens:$target,
			actual_prompt_tokens:$actual,
			generated_tokens:(.usage.completion_tokens // .timings.predicted_n // null),
			context_capacity_ok:(if (.usage.completion_tokens // .timings.predicted_n) == null then null else (($actual + (.usage.completion_tokens // .timings.predicted_n)) <= $nctx) end),
			run:$run,
			memory:{min_free_bytes:$min_free,peak_used_bytes:$peak_used}
		} | del(.content,.reasoning)' \
		"$response" >"$TMPDIR_BENCH/trial.json" || return 1
	if [ "$run" -ne 0 ]; then
		cat "$TMPDIR_BENCH/trial.json" >>"$RUNS_FILE"
	fi

	valid=$(jq -r '.protocol_valid // false' "$response")
	if [ "$valid" != true ]; then
		STABILITY_FAILURE=1
	fi
	if ! health; then
		ABORTED=1
		return 1
	fi
	return 0
}

# ---- preflight ------------------------------------------------------------

health || fail_json server_unhealthy "router health check failed"
ALL_MODELS=$(models_json) || fail_json models_unavailable "could not read /models"
STATUS_JSON=$(printf '%s\n' "$ALL_MODELS" | jq -c --arg model "$MODEL" '.data[]? | select(.id == $model) | .status' | head -n 1)
[ -n "$STATUS_JSON" ] || fail_json model_not_found "model is not present in router /models"

CURRENT_STATE=$(printf '%s\n' "$STATUS_JSON" | jq -r '.value // empty')
if [ "$EXCLUSIVE" -eq 0 ] && [ "$CURRENT_STATE" != loaded ]; then
	fail_json model_not_loaded "model must already be loaded unless --exclusive is used"
fi

# ---- lifecycle ------------------------------------------------------------

if [ "$EXCLUSIVE" -eq 1 ]; then
	loaded_models=$(printf '%s\n' "$ALL_MODELS" | jq -r '.data[]? | select(.status.value == "loaded") | .id')
	for loaded_model in $loaded_models; do
		request=$TMPDIR_BENCH/unload.json
		jq -nc --arg model "$loaded_model" '{model:$model}' >"$request" || fail_json request_build_failed "could not build unload request"
		http -H 'Content-Type: application/json' --data-binary "@$request" "$ROUTER_URL/models/unload" >/dev/null ||
			fail_json unload_failed "could not unload a loaded model"
	done
	wait_for_model_state unloaded >/dev/null 2>&1 || true

	start_ms=$(now_ms)
	SAW_DOWNLOADING=0
	start_vram_monitor &
	MONITOR_PID=$!
	post_model_action load >/dev/null || {
		stop_vram_monitor
		fail_json load_request_failed "model load request failed"
	}
	if ! wait_for_model_state loaded; then
		stop_vram_monitor
		fail_json model_load_failed "model did not reach loaded state"
	fi
	stop_vram_monitor
	end_ms=$(now_ms)
	LOAD_MS=$((end_ms - start_ms))
	LOAD_STATE=loaded
	if [ "$SAW_DOWNLOADING" -eq 1 ]; then
		LOAD_CACHED=false
	else
		LOAD_CACHED=true
	fi
else
	LOAD_STATE=not_measured
fi

STATUS_JSON=$(model_status) || fail_json status_unavailable "could not read effective model status"
PROPS_JSON=$(http -G --data-urlencode "model=$MODEL" "$ROUTER_URL/props") ||
	fail_json props_unavailable "could not read model properties"
N_CTX=$(printf '%s\n' "$PROPS_JSON" | jq -er '.default_generation_settings.n_ctx') ||
	fail_json props_invalid "model properties did not include context size"
BUILD_INFO=$(printf '%s\n' "$PROPS_JSON" | jq -r '.build_info // "unknown"')
EFFECTIVE_ARGS=$(printf '%s\n' "$STATUS_JSON" | jq -c '.args // []')
SAMPLING=$(printf '%s\n' "$PROPS_JSON" | jq -c '.default_generation_settings.params // {} | {temperature,top_k,top_p,min_p,repeat_penalty,presence_penalty,frequency_penalty,seed}')
TOTAL_VRAM=$(vram_total)
record_vram

# A small streamed request warms model execution without entering measured data.
WARMUP_CONTENT=$TMPDIR_BENCH/warmup.txt
make_content 32 0 "$WARMUP_CONTENT"
run_trial warmup 0 0 "$WARMUP_CONTENT" 512 >/dev/null 2>&1 || true
# Remove warm-up data from measured output.
: >"$RUNS_FILE"

# ---- size planning --------------------------------------------------------

# --gate-context defaults to the preset's real capacity in --full mode.
if [ "$GATE_CONTEXT" = capacity ]; then
	GATE_CONTEXT=$N_CTX
fi

if [ "$SIZES_SOURCE" = derive ]; then
	# Anchors: 4k, 25%, 50%, 75%, 100% of capacity, rounded down to 1k.
	oldifs=$IFS
	DERIVED=
	IFS='
'
	for size in $(printf '%s\n' \
		"$((GATE_CONTEXT / 4 / 1024 * 1024))" \
		"$((GATE_CONTEXT / 2 / 1024 * 1024))" \
		"$((GATE_CONTEXT * 3 / 4 / 1024 * 1024))" \
		"$GATE_CONTEXT" |
		awk -v cap="$GATE_CONTEXT" '{ if ($1 >= 4096 && $1 <= cap) print $1 }' |
		sort -n -u); do
		DERIVED="${DERIVED:+$DERIVED,}$size"
	done
	IFS=$oldifs
	case ",$DERIVED," in
	*,4096,*) ;;
	*) [ "$GATE_CONTEXT" -ge 8192 ] && DERIVED="4096,$DERIVED" ;;
	esac
	SIZES_LIST=$DERIVED
fi

# ---- benchmark ------------------------------------------------------------

oldifs=$IFS
IFS=,
for total in $SIZES_LIST; do
	case "$total" in
	'' | *[!0-9]*) fail_json invalid_sizes "--sizes element is not a positive integer: $total" ;;
	esac
	[ "$total" -ge 4096 ] || fail_json invalid_sizes "--sizes elements must be >= 4096: $total"
	[ $((total - DECODE_TOKENS)) -ge 1024 ] || fail_json invalid_sizes "size $total leaves no room for the decode budget: $DECODE_TOKENS"

	# Skip sizes that cannot fit the model's real context with the decode budget.
	if [ "$total" -gt "$N_CTX" ]; then
		SKIPPED_SIZES="${SKIPPED_SIZES:+$SKIPPED_SIZES,}$total"
		continue
	fi

	prompt_target=$((total - DECODE_TOKENS))

	trial_failed() {
		trial_mode=$1
		# Cold trials must have performed a real prefill: with cache_prompt:false
		# the server reports cache_n = 0 and prompt_n = full length. A near-total
		# cache hit means the server ignored cache_prompt and we measured nothing.
		jq -e --arg m "$trial_mode" '
			.protocol_valid == true and
			.context_capacity_ok != false and
			(if $m == "cold"
			 then ((.timings.cache_n // 0) < (.timings.prompt_n // 0))
			 else true end)' \
			"$TMPDIR_BENCH/trial.json" >/dev/null 2>&1
	}

	if [ "$MODE" = both ] || [ "$MODE" = warm ]; then
		warm_content=$TMPDIR_BENCH/warm-$total.txt
		warm_rendered=$TMPDIR_BENCH/warm-rendered-$total.txt
		warm_actual=$(build_workload "$prompt_target" 0 "$warm_content" "$warm_rendered") ||
			fail_json prompt_build_failed "could not build warm prompt"

		# Uncounted probe run primes the prompt cache and validates the size.
		run_trial warm "$total" 0 "$warm_content" "$warm_actual" >/dev/null 2>&1 || true
		if ! trial_failed warm; then
			CEILING_SIZE=$total
			CEILING_REASON=probe_failed
			break
		fi

		run=1
		while [ "$run" -le "$REPETITIONS" ]; do
			run_trial warm "$total" "$run" "$warm_content" "$warm_actual" || break
			run=$((run + 1))
		done
		[ "$ABORTED" -eq 0 ] || break
	fi

	if [ "$MODE" = both ] || [ "$MODE" = cold ]; then
		run=1
		while [ "$run" -le "$REPETITIONS" ]; do
			cold_content=$TMPDIR_BENCH/cold-$total-$run.txt
			cold_rendered=$TMPDIR_BENCH/cold-rendered-$total-$run.txt
			cold_actual=$(build_workload "$prompt_target" "$run" "$cold_content" "$cold_rendered") ||
				fail_json prompt_build_failed "could not build cold prompt"
			run_trial cold "$total" "$run" "$cold_content" "$cold_actual" || break
			# The first cold run doubles as the cold-mode probe.
			if [ "$run" -eq 1 ] && ! trial_failed cold; then
				CEILING_SIZE=$total
				CEILING_REASON=probe_failed
				break 2
			fi
			run=$((run + 1))
		done
		[ "$ABORTED" -eq 0 ] || break
	fi

	# Any failed or over-capacity measured run means this size (and anything
	# larger) cannot be trusted; sizes are ascending, so stop the sweep.
	[ "$ABORTED" -eq 0 ] || {
		CEILING_SIZE=$total
		CEILING_REASON=server_unhealthy
		break
	}
	size_bad=$(jq -s --argjson t "$total" \
		'any(.[]; .target_total_context_tokens == $t and
			(.protocol_valid != true or .context_capacity_ok == false))' \
		"$RUNS_FILE")
	[ "$size_bad" = true ] || continue
	CEILING_SIZE=$total
	CEILING_REASON=context_or_protocol
	break
done
IFS=$oldifs

[ "$ABORTED" -eq 0 ] || fail_json server_unhealthy "router became unhealthy during benchmark"

# ---- result ---------------------------------------------------------------

VRAM_STATS=$(vram_stats_json "$TOTAL_VRAM")
RESULTS=$(jq -s '
	def median:
		map(select(. != null)) | sort as $s | ($s|length) as $n |
		if $n == 0 then null
		elif ($n % 2) == 1 then $s[(($n / 2)|floor)]
		else (($s[($n / 2)|floor] + $s[(($n / 2)|floor)-1]) / 2)
		end;
	group_by(.mode, .target_total_context_tokens) |
	map({
		mode:.[0].mode,
		target_total_context_tokens:.[0].target_total_context_tokens,
		runs:length,
		actual_prompt_tokens_median:([.[].actual_prompt_tokens]|median),
		ttft_seconds_median:([.[].ttft_seconds]|median),
		prompt_tokens_per_second_median:([.[].timings.prompt_per_second]|median),
		generation_tokens_per_second_median:([.[].timings.predicted_per_second]|median),
		wall_seconds_median:([.[].wall_seconds]|median),
		protocol_valid:all(.protocol_valid == true),
		context_capacity_ok:all(.context_capacity_ok != false),
		failures:map(select(.protocol_valid != true)|.error)
	})
' "$RUNS_FILE")

GATE_OK=$(printf '%s\n' "$RESULTS" | jq -r \
	--argjson gate_ctx "$GATE_CONTEXT" \
	--argjson gate_runs "$GATE_RUNS" \
	'any(.[]; .target_total_context_tokens == $gate_ctx and .protocol_valid == true and .context_capacity_ok == true and .runs >= $gate_runs)')
[ "$GATE_OK" = true ] || CONTEXT_FAILURE=1
[ "$STABILITY_FAILURE" -eq 0 ] || OVERALL=failed
[ "$CONTEXT_FAILURE" -eq 0 ] || OVERALL=failed
: "${OVERALL:=passed}"

CEILING_JSON=null
if [ -n "$CEILING_SIZE" ]; then
	peak=$(jq -r '.memory.peak_used_bytes // null' "$TMPDIR_BENCH/trial.json" 2>/dev/null)
	if [ -n "$peak" ] && [ "$peak" != null ] && [ "$TOTAL_VRAM" != null ] &&
		[ "$peak" -ge $((TOTAL_VRAM * 98 / 100)) ]; then
		CEILING_REASON=vram_peak
	fi
	CEILING_JSON=$(jq -nc --argjson size "$CEILING_SIZE" --arg reason "$CEILING_REASON" '{size:$size,reason:$reason}')
fi
RAW_RUNS_JSON=$(jq -s '.' "$RUNS_FILE")

jq -nc \
	--arg model "$MODEL" \
	--arg url "$ROUTER_URL" \
	--arg build "$BUILD_INFO" \
	--argjson exclusive "$EXCLUSIVE" \
	--argjson status "$STATUS_JSON" \
	--argjson args "$EFFECTIVE_ARGS" \
	--argjson sampling "$SAMPLING" \
	--argjson nctx "$N_CTX" \
	--arg load_state "$LOAD_STATE" \
	--argjson load_ms "$LOAD_MS" \
	--argjson load_cached "$LOAD_CACHED" \
	--argjson total_vram "$TOTAL_VRAM" \
	--argjson memory "$VRAM_STATS" \
	--argjson results "$RESULTS" \
	--argjson raw_runs "$RAW_RUNS_JSON" \
	--argjson runs "$REPETITIONS" \
	--argjson decode "$DECODE_TOKENS" \
	--arg mode "$MODE" \
	--arg sizes "$SIZES_LIST" \
	--argjson gate_ctx "$GATE_CONTEXT" \
	--argjson gate_runs "$GATE_RUNS" \
	--arg skipped "$SKIPPED_SIZES" \
	--argjson ceiling "$CEILING_JSON" \
	--arg overall "$OVERALL" \
	--argjson stable "$STABILITY_FAILURE" \
	--argjson context_failure "$CONTEXT_FAILURE" \
	'{schema_version:2,status:$overall,model:$model,router_url:$url,exclusive:$exclusive,mode:$mode,server:{build_info:$build,effective_args:$args,status:$status,sampling:$sampling,context_size:$nctx},requirements:{repetitions:$runs,generation_tokens:$decode,gate:{context:$gate_ctx,runs:$gate_runs}},sizes:($sizes|split(",")|map(tonumber)),skipped_sizes:($skipped|if . == "" then [] else (split(",")|map(tonumber)) end),capacity_ceiling:$ceiling,load:{state:$load_state,elapsed_ms:$load_ms,cached:$load_cached},memory:$memory,results:$results,raw_runs:$raw_runs,gates:{stability:(if $stable == 0 then "passed" else "failed" end),context_gate:(if $context_failure == 0 then "passed" else "failed" end)}}'

[ "$OVERALL" = passed ]
